{
  "name": "simple-function-and-test",
  "description": "This includes a simple function and a test. Use as a template for creating new packages.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node ./index.ts",
    "start": "node ./index.ts",
    "ut": "node --experimental-test-coverage --test **/*.test.ts",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "solid-js": "^1.9.14",
    "typescript": "^7.0.2"
  }
}
