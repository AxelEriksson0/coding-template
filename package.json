{
  "name": "coding-template",
  "version": "2.0.0",
  "description": "My opinionated coding template",
  "keywords": [
    "oxlint",
    "pnpm",
    "template",
    "typescript"
  ],
  "homepage": "https://github.com/AxelEriksson0/coding-template#readme",
  "bugs": {
    "url": "https://github.com/AxelEriksson0/coding-template/issues"
  },
  "license": "MIT",
  "author": "Axel Eriksson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AxelEriksson0/coding-template.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev": "pnpm --recursive --parallel run dev",
    "format": "oxfmt .",
    "lint": "oxlint --type-aware",
    "prepare": "lefthook install",
    "start": "pnpm --recursive --parallel run start",
    "test": "pnpm format && pnpm lint && pnpm ut",
    "update": "pnpm update:node && pnpm update:pnpm && pnpm update:dependencies",
    "update:dependencies": "pnpm update --recursive --include-workspace-root --latest && pnpm dedupe",
    "update:node": "NODE_VERSION_WITH_V=$(fnm list-remote --latest) && NODE_VERSION=$(printf '%s' \"$NODE_VERSION_WITH_V\" | sed 's/^v//') && FNM_COREPACK_ENABLED=false fnm install \"$NODE_VERSION_WITH_V\" && FNM_COREPACK_ENABLED=false fnm use \"$NODE_VERSION_WITH_V\" && npm install --global corepack@latest && corepack enable && echo \"$NODE_VERSION_WITH_V\" > .node-version && npm pkg set engines.node=\">=$NODE_VERSION\"",
    "update:pnpm": "corepack use pnpm@latest",
    "ut": "pnpm --recursive run ut"
  },
  "dependencies": {
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "engines": {
    "node": ">=26.9.0"
  },
  "packageManager": "pnpm@12.5.1"
}
